# 加入机器人实际使用的 .env.prod 或 .env.dev，修改后重启机器人。
# 群里申请、私聊接收 Token。请先添加机器人好友，私聊失败时会作废本次 Token。

# 可自定义多个群；[] 表示不响应任何群。后台也必须放行这些群号。
LAUNCH_AUTH_GROUPS=[123456789,987654321]

# 机器人与授权服务在同一台服务器时：
LAUNCH_AUTH_URL=http://127.0.0.1:18797

# 如果机器人在目前已建立 SSH 通道的 Windows 电脑上，则改为：
# LAUNCH_AUTH_URL=http://127.0.0.1:19797

# 远程部署时将示例地址替换为实际地址：
# LAUNCH_AUTH_URL=https://auth.example.com:18443

# 使用专用 CA 时填写 CA 公钥文件路径；系统信任证书保持为空：
LAUNCH_AUTH_CA_FILE=

# 填 server-access.json 中的 bot_key，不是 admin_key 或 SSH 密码。
LAUNCH_AUTH_BOT_KEY=

# 同一 QQ 的请求间隔，单位秒，允许 5–300，默认 30。
LAUNCH_AUTH_COOLDOWN=30
