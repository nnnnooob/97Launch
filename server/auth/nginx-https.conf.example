server {
    listen 18443 ssl;
    server_name auth.example.com;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/97launch-auth/tls/server.pem;
    ssl_certificate_key /etc/97launch-auth/tls/server.key;
    client_max_body_size 16k;
    access_log off;
    location = /healthz { proxy_pass http://127.0.0.1:18797; }
    location /api/v1/bot/ { proxy_pass http://127.0.0.1:18797; }
    location = /api/v1/pairing/redeem { proxy_pass http://127.0.0.1:18797; }
    location = /api/v1/devices/me { proxy_pass http://127.0.0.1:18797; }
    location = /api/v1/devices/heartbeat { proxy_pass http://127.0.0.1:18797; }
    location = /api/v1/devices/logout { proxy_pass http://127.0.0.1:18797; }
    location /api/v1/servers { proxy_pass http://127.0.0.1:18797; proxy_read_timeout 90s; }
    location /api/v1/packs/ {
        proxy_pass http://127.0.0.1:18797;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 90s;
        send_timeout 90s;
    }
    location = /api/admin/uploads { proxy_pass http://127.0.0.1:18797; }
    location = /api/admin/packs { proxy_pass http://127.0.0.1:18797; }
    location /api/admin/uploads/ {
        client_max_body_size 1m;
        client_body_buffer_size 32k;
        client_body_timeout 90s;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:18797;
        proxy_read_timeout 300s;
        proxy_send_timeout 90s;
    }
    location /api/admin/packs/ {
        proxy_pass http://127.0.0.1:18797;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 90s;
        send_timeout 90s;
    }
    location /api/admin/mcsm {
        proxy_pass http://127.0.0.1:18797;
        proxy_read_timeout 90s;
    }
    location /api/v1/updates/ {
        proxy_pass http://127.0.0.1:18797;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 90s;
        send_timeout 90s;
    }
    location /api/admin/releases/ {
        client_max_body_size 1m;
        client_body_buffer_size 32k;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:18797;
        proxy_read_timeout 300s;
    }
    location /api/admin/ { proxy_pass http://127.0.0.1:18797; }
    location /static/ { proxy_pass http://127.0.0.1:18797; }
    location = / { proxy_pass http://127.0.0.1:18797; }
    location / { return 404; }
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
}
