IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app-icon.ico"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LAUNCH_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LAUNCH_BUILD_NUMBER@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "97Launch"
   VALUE "FileDescription", "97Launch Qt"
   VALUE "FileVersion", "@PROJECT_VERSION@.@LAUNCH_BUILD_NUMBER@"
   VALUE "ProductName", "97Launch Qt"
   VALUE "ProductVersion", "@LAUNCH_RELEASE_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
