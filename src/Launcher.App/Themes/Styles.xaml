<!--
  App-wide style definitions.

  Everything here is Fluent-default compatible; we only add the handful of
  styles the shell needs (page scrollers, section headers, the start button
  accent, placeholder panels).

  Note on theme brushes: this file deliberately declares no
  ResourceDictionary.ThemeDictionaries of its own. A merged dictionary that
  both defines theme dictionaries AND has styles inside it that resolve
  ThemeResource keys against those same dictionaries crashes the WinUI markup
  compiler (it exits 1 with no diagnostic). The built-in theme resources
  (CardBackgroundFillColorDefaultBrush, CardStrokeColorDefaultBrush,
  TextFillColorSecondaryBrush and friends) already cover every need here, so
  the custom Light/Dark brushes were removed rather than worked around.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ brand colours ============ -->
    <!--
      HarmonyOS blue. The key names keep their original "Green" spelling so the
      many references below do not have to change; only the values moved.
    -->
    <Color x:Key="BrandGreenColor">#0A59F7</Color>
    <Color x:Key="BrandGreenDarkColor">#0846C4</Color>

    <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreenColor}" />
    <SolidColorBrush x:Key="BrandGreenDarkBrush" Color="{StaticResource BrandGreenDarkColor}" />

    <!-- ============ page scaffolding ============ -->

    <!--
      Reusable scroll container for a page's root.

      Padding is inlined rather than factored into a Thickness resource: WinUI's
      XAML compiler cannot take a bare Thickness as a ResourceDictionary child,
      so a shared Thickness key is not an option here.
    -->
    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="32,20,32,24" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Section header used between groups of cards. -->
    <Style x:Key="SettingHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,10" />
    </Style>

    <!-- Placeholder card used on every not-yet-implemented page. -->
    <Style x:Key="PlaceholderCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="32,28,32,28" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============ launch button ============ -->

    <Style x:Key="LaunchButtonStyle" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#226DF5" />
                <GradientStop Offset="1" Color="#084BCF" />
            </LinearGradientBrush></Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="56" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="LaunchSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="LaunchHover.Opacity" Value="0.09" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="LaunchPress.Opacity" Value="0.12" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="FocusStates">
                            <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="LaunchFocus.Opacity" Value="1" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="PointerFocused" />
                            <VisualState x:Name="Unfocused" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                    <Border x:Name="LaunchHover" Background="White" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="LaunchPress" Background="Black" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                    <Grid x:Name="LaunchShine" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="LaunchIcon" Width="34" Height="34" CornerRadius="10" Background="#1FFFFFFF" Visibility="Collapsed">
                            <Grid>
                                <Viewbox x:Name="LaunchPlay" Width="16" Height="16"><SymbolIcon Symbol="Play" Foreground="{TemplateBinding Foreground}" /></Viewbox>
                                <ProgressRing x:Name="LaunchBusy" Width="20" Height="20" IsActive="False" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ContentPresenter VerticalContentAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <Border x:Name="LaunchFocus" Margin="4" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <!--
      Secondary action next to the primary launch button: same height so the row
      aligns, but square, neutral-filled and icon-only, so it reads as support
      rather than competing with the green primary.
    -->
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============ account pane ============ -->

    <!--
      Account chip: a transparent button that reads as a header row, not as a
      control. The default Button template draws a focus rectangle over the whole
      bounds, which turns the chip into a hard black box the moment it has focus
      (it takes focus at startup because the flyout anchor is a tab stop). Giving
      it an explicit template drops that visual while keeping it keyboard
      reachable and clickable.
    -->
    <Style x:Key="AccountChipStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!--
          Suppressed because the system focus visual is the hard black rectangle
          seen around the chip; keyboard access still works, and the flyout
          itself is where focus lands once opened.
        -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="6">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="{ThemeResource SubtleFillColorTertiary}" />
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Avatar frame in the sidebar chip. Square with a small radius, the shape the
      game itself draws a head in, and sized to match the two text lines beside it.
    -->
    <Style x:Key="AvatarPlaceholderStyle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AccountNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!--
          No fixed MaxWidth: the chip lives in a pane whose width is set by
          OpenPaneLength, and a hardcoded limit clipped names long before the
          available space ran out. Long names scroll instead (see
          ScrollingNameStyle), so trimming here would fight that.
        -->
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--
      Single-line text that scrolls when it overflows its slot.

      TextBlock has no marquee of its own. The ScrollViewer starts Horizontal
      scrolling disabled so a short name sits still, and the code-behind turns
      scrolling on only when the content is measurably wider than the viewport;
      an always-scrolling viewer would make every short name drift.
    -->
    <Style x:Key="ScrollingNameHostStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollMode" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="IsHorizontalRailEnabled" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ icons ============ -->

    <!--
      Lucide icons are stroke drawings, not filled silhouettes. PathIcon always
      fills its Data, so a 2px stroke outline becomes a solid blob at small
      sizes: the rocket reads as two smudges and the box collapses into a
      hexagon. Rendering them as a stroked Path keeps the line art intact, which
      is why navigation items put a Path in Content instead of using the Icon
      property (whose type is IconElement and cannot host a Path).

      Stretch=None keeps the 24x24 coordinate space the paths are authored in,
      so StrokeThickness stays an absolute 1.6px rather than being scaled with
      the geometry.
    -->
    <Style x:Key="LineIconStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{ThemeResource IconForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Wraps a LineIconStyle Path at 16px, the size navigation rows want. -->
    <Style x:Key="NavIconViewboxStyle" TargetType="Viewbox">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============ status bar ============ -->

    <Style x:Key="StatusBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- ============ activity log ============ -->

    <!--
      Log pane header: title plus the clear action, separated from the lines
      below by a hairline so the list reads as a scrollable body.
    -->
    <Style x:Key="LogHeaderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
      One log row. A fixed-width level badge keeps the message column aligned
      regardless of severity, which is what makes a scrolling log scannable.
    -->
    <Style x:Key="LogRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,3" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="LogMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="LogMessageTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
      Level badge. The pill carries the severity colour; the text inside stays
      neutral so it remains legible in both themes.
    -->
    <Style x:Key="LogLevelBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinWidth" Value="38" />
    </Style>

    <!--
      Log list item: no hover fill or selection tint, because the pane is a
      read-only readout rather than a list of things to act on.
    -->
    <Style x:Key="LogListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <!-- ============ launch status card ============ -->

    <!--
      Hero card at the top of the launch page. The gradient is supplied inline on
      the element rather than through a Setter here: a Setter.Value holding a
      LinearGradientBrush makes the WinUI markup compiler exit 1 with no
      diagnostic during pass 1.
    -->
    <Style x:Key="StatusHeroCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!--
      Brand gradient for the status card, defined once so the page stays clean.
      Three stops rather than two: a two-stop blue ramp reads as flat at this
      size, while a lighter mid stop gives the card the same sense of depth as
      HarmonyOS's own accent surfaces.
    -->
    <LinearGradientBrush x:Key="StatusHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#0A59F7" />
            <GradientStop Offset="0.55" Color="#2F6BE8" />
            <GradientStop Offset="1" Color="#0B3FAE" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#E6FFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      Readiness dot. Fixed size and round so the red/green state reads at a glance
      regardless of the label text next to it.
    -->
    <Style x:Key="ReadinessDotStyle" TargetType="Border">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      Attribute bubble for the metadata row. Translucent white over the gradient
      keeps the chips legible without introducing a second palette.
    -->
    <Style x:Key="HeroChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ summary cards ============ -->

    <!--
      Equal-width metric tile. Used three-up beneath the launch button; the row
      is a Grid with star columns rather than a StackPanel so the tiles stay equal
      no matter how long a value is.
    -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- ============ instance browser ============ -->

    <!-- Folder rail on the left of the instances page. -->
    <Style x:Key="FolderRailStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!--
      Folder row. The default ListView selection is a very light grey fill, which
      is nearly invisible against the card background and gives no clue which
      folder the instance list belongs to. The custom template below adds a
      brand-green left bar plus a tinted fill for the selected row, so the
      current folder is unmistakable.
    -->
    <Style x:Key="FolderListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="40" />
        <!--
          No vertical margin: a 1px gap between rows is not part of either item's
          hit area, so a click near a boundary lands on the neighbouring row and
          selects something the user did not point at.
        -->
        <Setter Property="Margin" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectedFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard>
                                        <!--
                                          Suppress the grey hover tint while the row
                                          is selected. Without this the hover state
                                          paints over the selection and the blue only
                                          appears once the pointer leaves.
                                        -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectedFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="SelectedPressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectedFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border
                            x:Name="HoverFill"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <!--
                          SelectedFill is declared AFTER HoverFill so that it paints
                          on top: the hover tint is opaque grey, and with the old
                          order a hovered selected row showed only the grey until
                          the pointer left. Painting selection last keeps the blue
                          visible while hovering, which is when the user is usually
                          looking at it.
                        -->
                        <Border
                            x:Name="SelectedFill"
                            Background="#330A59F7"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <!-- Left accent bar: the strongest signal, readable even
                             for users who cannot distinguish the tint. -->
                        <Border
                            x:Name="SelectionBar"
                            Width="3"
                            Margin="0,4"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource BrandGreenBrush}"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="FolderPathTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Shared instance and Minecraft download group styling. -->
<Style x:Key="InstanceGroupStyle" TargetType="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
</Style>
<Style x:Key="InstanceGroupListStyle" TargetType="ListView">
    <Setter Property="SelectionMode" Value="None" />
    <Setter Property="IsItemClickEnabled" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
</Style>
<Style x:Key="InstanceGroupRowStyle" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListViewItem">
            <ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate></Setter.Value>
    </Setter>
</Style>

    <!--
      Instance card container. The whole row is clickable (it jumps to the launch
      page with that instance selected), so the item needs a pressable look
      without the default ListView selection chrome: selection is momentary and
      immediately navigates away.
    -->
    <Style x:Key="InstanceListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid
                        x:Name="Root"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Card border drawn inside the item. -->
                        <Border
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Padding="12,10" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Invisible full-card click target. It fills the instance card and sits under
      the card content, which is hit-test-disabled, so pressing anywhere on the
      row reaches this button while the three row actions keep their own clicks.
    -->
    <Style x:Key="CardHitTargetStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverFill"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border
                            x:Name="HoverFill"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Opacity="0" />

                        <ContentPresenter
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Icon-only row action inside an instance card. Small on purpose: three of
      them sit beside the instance name, and full-size buttons would out-weigh
      the content they act on.
    -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
      Login-type pill in the account flyout. A checked pill fills with the accent
      tint and its text turns accent-coloured, so the current choice is legible at a
      glance without a separate selection indicator occupying layout.
    -->
    <Style x:Key="AccountTypePillStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!--
      Small square icon button for account row actions. Sized like the instance
      card actions so the two surfaces keep the same visual weight.
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="GameSessionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- One instance card. -->
    <Style x:Key="InstanceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="InstanceNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="InstanceMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Small loader pill inside an instance card. -->
    <Style x:Key="LoaderBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LoaderBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Circular scroll-to-top button floating over the instance list. -->
    <Style x:Key="ScrollTopButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

</ResourceDictionary>
