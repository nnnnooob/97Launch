<Window
    x:Class="Launcher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Launcher.App.Views">

    <!--
      Mica keeps the window chrome light while letting page content carry the
      colour. Set in XAML rather than code so it survives theme changes.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="DropHost" AllowDrop="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ custom title bar ============ -->
        <Grid x:Name="AppTitleBar" Height="32" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Source="Assets/AppIcon.png"
                Width="16"
                Height="16"
                Margin="16,0,8,0"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="AppTitleTextBlock"
                Grid.Column="1"
                Style="{ThemeResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ============ navigation shell ============ -->
        <NavigationView
            x:Name="NavView"
            Visibility="Collapsed"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="176"
            CompactPaneLength="48"
            SelectionChanged="NavView_SelectionChanged">

            <!--
              The account chip lives in the pane header, i.e. at the top of the
              navigation pane, so the signed-in identity is always the first
              thing visible rather than buried at the bottom.
            -->
            <NavigationView.PaneHeader>
                <StackPanel Margin="0,4,0,0">
                    <Button
                        x:Name="AccountChipButton"
                        Style="{ThemeResource AccountChipStyle}"
                        Click="AccountChip_Click"
                        ToolTipService.ToolTip="账号管理">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                              The head is clipped to the frame's radius by the
                              border, so the image needs no corner handling of its
                              own. Signed out shows a vanilla head rather than an
                              outline, which is what PCL does too.
                            -->
                            <Border Style="{ThemeResource AvatarPlaceholderStyle}">
                                <Image
                                    Source="{x:Bind ViewModel.AccountAvatar, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <!--
                                  The name scrolls when it outgrows the pane
                                  instead of being cut off with an ellipsis, so a
                                  long Microsoft account is still readable.
                                -->
                                <ScrollViewer
                                    x:Name="AccountNameScroller"
                                    Style="{ThemeResource ScrollingNameHostStyle}">
                                    <TextBlock
                                        x:Name="AccountNameText"
                                        Style="{ThemeResource AccountNameStyle}"
                                        Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" />
                                </ScrollViewer>
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Text="{x:Bind ViewModel.CurrentAccount.AccountType, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!--
                      Separates the identity block from the navigation list. The
                      account chip is not a destination, so without a divider it
                      reads as the first nav row.
                    -->
                    <Border
                        Height="1"
                        Margin="8,12,8,8"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LaunchNavItem" Tag="launch">
                    <NavigationViewItem.Content>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Style="{ThemeResource NavIconViewboxStyle}"><Path Data="{StaticResource IconLightning}" Style="{ThemeResource LineIconStyle}" /></Viewbox>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="启动" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.LaunchActiveBadge, Mode=OneWay}" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="instances">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Viewbox Style="{ThemeResource NavIconViewboxStyle}"><Path Data="{StaticResource IconBox}" Style="{ThemeResource LineIconStyle}" /></Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="实例" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="download">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Viewbox Style="{ThemeResource NavIconViewboxStyle}"><Path Data="{StaticResource IconDownload}" Style="{ThemeResource LineIconStyle}" /></Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="下载" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="transfer" ToolTipService.ToolTip="{x:Bind ViewModel.TransferStatusTooltip, Mode=OneWay}">
                    <NavigationViewItem.Content>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Style="{ThemeResource NavIconViewboxStyle}"><Path Data="{StaticResource IconPackage}" Style="{ThemeResource LineIconStyle}" /></Viewbox>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="传输" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.TransferActiveBadge, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.TransferWaitingBadge, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.TransferErrorBadge, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="settings">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Viewbox Style="{ThemeResource NavIconViewboxStyle}"><Path Data="{StaticResource IconSettings}" Style="{ThemeResource LineIconStyle}" /></Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- ============ status bar ============ -->
        <Border
            x:Name="StatusBar"
            Visibility="Collapsed"
            Grid.Row="2"
            Style="{ThemeResource StatusBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Style="{ThemeResource StatusBarTextStyle}"
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock Style="{ThemeResource StatusBarTextStyle}" Text=".NET 8 · WinUI 3" />
                    <TextBlock Style="{ThemeResource StatusBarTextStyle}" Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" />
                    <TextBlock Style="{ThemeResource StatusBarTextStyle}" Text="{x:Bind ViewModel.VersionDisplay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
          Modal overlay layer for dialogs that cannot host themselves, such as the
          one opened from the account flyout: a flyout closes when focus leaves it,
          so the dialog has to live outside it. Covers the page area only, leaving the
          title bar and status bar visible.
        -->
        <Grid
            x:Name="DialogLayer"
            Grid.Row="1"
            Margin="176,0,0,0"
            Canvas.ZIndex="100"
            Visibility="Collapsed" />

        <Grid x:Name="DropOverlay" Grid.Row="1" Canvas.ZIndex="300" Visibility="Collapsed"
              Background="Transparent" AllowDrop="True">
            <Border x:Name="DropTint" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.025" IsHitTestVisible="False" />
            <Grid x:Name="DropPointerShine" IsHitTestVisible="False" />
            <Border x:Name="DropCard" Margin="24,24,24,24" MaxWidth="480" VerticalAlignment="Bottom"
                    CornerRadius="16" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid>
                    <Grid x:Name="DropCardShine" IsHitTestVisible="False" />
                    <Grid Padding="20,18" ColumnSpacing="16" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="13" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Viewbox x:Name="DropIcon" Width="23" Height="23">
                                    <Path Data="{StaticResource IconDownload}" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Viewbox>
                                <ProgressRing x:Name="DropBusy" Width="23" Height="23" IsActive="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="DropHeading" Text="松开以导入" FontSize="18" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DropTarget" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DropPackHint" Text="整合包 → 创建新实例" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            x:Name="ToastBar"
            Grid.Row="1"
            Canvas.ZIndex="200"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="192,16,16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.LiveSetting="Polite"
            IsOpen="False"
            IsClosable="True"
            PointerEntered="ToastBar_PointerEntered"
            PointerExited="ToastBar_PointerExited">
            <InfoBar.IconSource>
                <SymbolIconSource Symbol="Download" />
            </InfoBar.IconSource>
            <InfoBar.Shadow><ThemeShadow /></InfoBar.Shadow>
        </InfoBar>

    </Grid>
</Window>
