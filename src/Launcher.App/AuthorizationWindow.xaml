<Window
    x:Class="Launcher.App.AuthorizationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Launcher.App.Views">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AuthorizationTitleBar">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock x:Name="AuthorizationTitle" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
        <ContentControl x:Name="WindowContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <views:WelcomePairingView />
        </ContentControl>
    </Grid>
</Window>
