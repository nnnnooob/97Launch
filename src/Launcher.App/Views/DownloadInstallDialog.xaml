<UserControl
    x:Class="Launcher.App.Views.DownloadInstallDialog"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LoaderPanelFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#EAF2FC" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#F1F5FA" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#DFEAF8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LoaderPanelFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#26384F" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#29313C" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#344359" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LoaderPanelFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="LoaderSelectedStrokeBrush" Color="#6DA6F4" />

            <Style x:Key="LoaderCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="LoaderHeaderStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="LoaderClearButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LoaderPanelStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="6,4,6,6" />
                <Setter Property="Spacing" Value="2" />
                <Setter Property="Background" Value="{ThemeResource LoaderPanelFillBrush}" />
            </Style>
            <Style x:Key="LoaderDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,0,4,6" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="LoaderVersionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" /><Setter Property="FocusVisualMargin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RowRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowHoverBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowPressedBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RowRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LoaderHeaderDetailStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="LoaderChevronStyle" TargetType="FontIcon">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LoaderVersionDetailStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="LoaderSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="10,8,0,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LoaderBadgeStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <DataTemplate x:Key="LoaderVersionRowTemplate">
                <Button
                    Style="{StaticResource LoaderVersionButtonStyle}"
                    Click="SelectLoaderVersion_Click"
                    Loaded="LoaderVersionRow_Loaded"
                    Tag="{Binding}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Source="{Binding Icon}"
                        Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            FontSize="12"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Text="{Binding Badge}" />
                </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="DialogOverlay"
        Padding="40"
        Background="#8C000000"
        SizeChanged="DialogOverlay_SizeChanged">
        <Border
            x:Name="DialogCard"
            MaxWidth="860"
            MaxHeight="560"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="20"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{StaticResource StatusHeroBrush}"
                    Style="{ThemeResource StatusHeroCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Button
                            x:Name="HeaderBackButton"
                            Width="38"
                            Height="38"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#22FFFFFF"
                            BorderThickness="0"
                            Click="Back_Click"
                            ToolTipService.ToolTip="返回">
                            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="White" />
                        </Button>

                        <Border
                            Width="56"
                            Height="56"
                            VerticalAlignment="Center"
                            Background="#33FFFFFF"
                            CornerRadius="9">
                            <Image
                                x:Name="InstanceIcon"
                                Width="44"
                                Height="44"
                                Source="ms-appx:///Assets/Blocks/grasspath.png"
                                Stretch="Uniform" />
                        </Border>
                        </StackPanel>

                        <TextBox
                            x:Name="InstanceNameBox"
                            Grid.Column="1"
                            MinHeight="44"
                            VerticalAlignment="Center"
                            Background="#20FFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            FontSize="21"
                            Foreground="White"
                            PlaceholderText="实例名称"
                            SelectionHighlightColor="#80FFFFFF"
                            Text="1.20.1">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <!-- Keep the system TextBox states legible on the blue hero surface. -->
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2EFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2EFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A6FFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#CCFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#CCFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#CCFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFFFF" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,8" HorizontalAlignment="Stretch" Spacing="8">
                        <StackPanel x:Name="ModificationOptions" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Minecraft 版本" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ModificationMinecraft" HorizontalAlignment="Stretch" SelectionChanged="ModificationMinecraft_Changed"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="恢复原组件" Click="RestoreOriginal_Click"/>
                                <Button x:Name="RecoverModificationButton" Content="恢复未完成的修改" Click="RecoverModification_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="ModificationOriginalName" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ModificationComparisons" Spacing="6"/>
                            <TextBlock x:Name="ModificationStatus" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                        <Border x:Name="ForgeCard" Style="{StaticResource LoaderCardStyle}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ForgeHeader"
                                    Style="{StaticResource LoaderHeaderStyle}"
                                    Click="Loader_Click"
                                    Tag="Forge">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="24" Height="24" Source="ms-appx:///Assets/Blocks/forge.png" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Forge" />
                                    <TextBlock x:Name="ForgeHeaderDetail" Grid.Column="2" Style="{StaticResource LoaderHeaderDetailStyle}" Text="点击选择版本" />
                                    <FontIcon x:Name="ForgeChevron" Grid.Column="3" Style="{StaticResource LoaderChevronStyle}" Glyph="&#xE70D;" />
                                </Grid>
                                </Button>
                                <Button x:Name="ForgeClearButton" Grid.Column="1" Style="{StaticResource LoaderClearButtonStyle}" Click="ClearComponent_Click" Tag="Forge" ToolTipService.ToolTip="清除 Forge" Visibility="Collapsed">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8BB;" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ForgeVersionPanel" Style="{StaticResource LoaderPanelStyle}" Visibility="Collapsed">
                                <Border Style="{StaticResource LoaderDividerStyle}" />
                                <ContentControl
                                    x:Name="ForgeRecommendedVersionRow"
                                    ContentTemplate="{StaticResource LoaderVersionRowTemplate}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="ForgeLatestButton"
                                    Style="{StaticResource LoaderVersionButtonStyle}"
                                    Click="SelectLatestVersion_Click"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="ForgeLatestIcon" Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="ForgeLatestVersion" FontSize="14" />
                                            <TextBlock x:Name="ForgeLatestDetail" Style="{StaticResource LoaderVersionDetailStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource LoaderBadgeStyle}" Text="最新版本" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="ForgeAllVersionsLabel" Style="{StaticResource LoaderSectionLabelStyle}" />
                                <ItemsControl x:Name="ForgeAllVersions" ItemTemplate="{StaticResource LoaderVersionRowTemplate}" />
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NeoForgeCard" Style="{StaticResource LoaderCardStyle}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="NeoForgeHeader"
                                    Style="{StaticResource LoaderHeaderStyle}"
                                    Click="Loader_Click"
                                    Tag="NeoForge">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="24" Height="24" Source="ms-appx:///Assets/Blocks/neoforge.png" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="NeoForge" />
                                    <TextBlock x:Name="NeoForgeHeaderDetail" Grid.Column="2" Style="{StaticResource LoaderHeaderDetailStyle}" Text="点击选择版本" />
                                    <FontIcon x:Name="NeoForgeChevron" Grid.Column="3" Style="{StaticResource LoaderChevronStyle}" Glyph="&#xE70D;" />
                                </Grid>
                                </Button>
                                <Button x:Name="NeoForgeClearButton" Grid.Column="1" Style="{StaticResource LoaderClearButtonStyle}" Click="ClearComponent_Click" Tag="NeoForge" ToolTipService.ToolTip="清除 NeoForge" Visibility="Collapsed">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8BB;" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="NeoForgeVersionPanel" Style="{StaticResource LoaderPanelStyle}" Visibility="Collapsed">
                                <Border Style="{StaticResource LoaderDividerStyle}" />
                                <Button
                                    x:Name="NeoForgeLatestButton"
                                    Style="{StaticResource LoaderVersionButtonStyle}"
                                    Click="SelectLatestVersion_Click"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="NeoForgeLatestIcon" Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="NeoForgeLatestVersion" FontSize="14" />
                                            <TextBlock x:Name="NeoForgeLatestDetail" Style="{StaticResource LoaderVersionDetailStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource LoaderBadgeStyle}" Text="最新版本" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="NeoForgeAllVersionsLabel" Style="{StaticResource LoaderSectionLabelStyle}" />
                                <ItemsControl x:Name="NeoForgeAllVersions" ItemTemplate="{StaticResource LoaderVersionRowTemplate}" />
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FabricCard" Style="{StaticResource LoaderCardStyle}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="FabricHeader"
                                    Style="{StaticResource LoaderHeaderStyle}"
                                    Click="Loader_Click"
                                    Tag="Fabric">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="24" Height="24" Source="ms-appx:///Assets/Blocks/fabric.png" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Fabric" />
                                    <TextBlock x:Name="FabricHeaderDetail" Grid.Column="2" Style="{StaticResource LoaderHeaderDetailStyle}" Text="点击选择版本" />
                                    <FontIcon x:Name="FabricChevron" Grid.Column="3" Style="{StaticResource LoaderChevronStyle}" Glyph="&#xE70D;" />
                                </Grid>
                                </Button>
                                <Button x:Name="FabricClearButton" Grid.Column="1" Style="{StaticResource LoaderClearButtonStyle}" Click="ClearComponent_Click" Tag="Fabric" ToolTipService.ToolTip="清除 Fabric" Visibility="Collapsed">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8BB;" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="FabricVersionPanel" Style="{StaticResource LoaderPanelStyle}" Visibility="Collapsed">
                                <Border Style="{StaticResource LoaderDividerStyle}" />
                                <Button
                                    x:Name="FabricLatestButton"
                                    Style="{StaticResource LoaderVersionButtonStyle}"
                                    Click="SelectLatestVersion_Click"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="FabricLatestIcon" Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="FabricLatestVersion" FontSize="14" />
                                            <TextBlock x:Name="FabricLatestDetail" Style="{StaticResource LoaderVersionDetailStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource LoaderBadgeStyle}" Text="最新版本" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="FabricAllVersionsLabel" Style="{StaticResource LoaderSectionLabelStyle}" />
                                <ItemsControl x:Name="FabricAllVersions" ItemTemplate="{StaticResource LoaderVersionRowTemplate}" />
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="AdditionalOptionsPanel" Spacing="8" />

                        <TextBlock
                            x:Name="SelectionHint"
                            Margin="2,2,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Padding="0,8,0,2" HorizontalAlignment="Center" Spacing="6">
                    <Button
                        x:Name="StartInstallButton"
                        MinWidth="190"
                        Height="48"
                        Padding="24,0"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Click="StartDownload_Click"
                        CornerRadius="24"
                        Foreground="White"
                        Style="{ThemeResource LaunchButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="17" Height="17" Stretch="Uniform">
                                <Path
                                    Data="{StaticResource IconDownload}"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8" />
                            </Viewbox>
                            <TextBlock x:Name="StartInstallLabel" FontSize="16" Foreground="White" Text="开始下载" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        FontSize="11"
                        Text="任务将按顺序加入传输队列"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
