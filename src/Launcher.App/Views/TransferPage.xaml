<Page
    x:Class="Launcher.App.Views.TransferPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="TransferActionStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,24,28,20" RowSpacing="22" MaxWidth="1320" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="24,20">
            <Grid ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Native vector animation: files descend into the download tray. -->
                <Grid Width="104" Height="104" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Border CornerRadius="26" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.07" />
                    <Canvas Width="104" Height="104">
                        <Path Data="M 28,39 C 19,39 17,27 25,23 C 25,12 41,8 48,17 C 56,10 68,17 67,25 C 80,24 83,39 71,41"
                              Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45" />
                        <Border x:Name="DownloadPacket" Canvas.Left="43" Canvas.Top="29" Width="20" Height="26"
                                CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <StackPanel Margin="5,7" Spacing="4">
                                <Border Height="2" Background="White" Opacity="0.9" />
                                <Border Height="2" Width="6" HorizontalAlignment="Left" Background="White" Opacity="0.6" />
                            </StackPanel>
                        </Border>
                        <Path Data="M 27,65 L 20,80 Q 19,85 24,85 L 80,85 Q 85,85 84,80 L 77,65 M 27,65 L 39,65 L 43,73 L 61,73 L 65,65 L 77,65"
                              Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse x:Name="DownloadLight" Width="5" Height="5" Canvas.Left="72" Canvas.Top="77"
                                 Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="传输中心" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,5,0,0" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="SpeedPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4"
                            Visibility="{x:Bind ViewModel.ActiveProgressVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="下载速度" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="16"
                      Visibility="{x:Bind ViewModel.ActiveProgressVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{x:Bind ViewModel.CurrentTaskProgress, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"
                                 AutomationProperties.Name="当前任务进度" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentTaskProgressText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowSpacing="12" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="任务列表" FontSize="15" FontWeight="SemiBold" Margin="2,0" />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="20" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{Binding StateIcon}" FontSize="18" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Target}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Target}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Margin="4,0">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ProgressLabel}" FontSize="12" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TransferActionStyle}" Visibility="{Binding OutputFileVisibility}"
                                                    Click="LocateOutput_Click" ToolTipService.ToolTip="定位导出文件" AutomationProperties.Name="定位导出文件">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                            </Button>
                                            <Button Style="{StaticResource TransferActionStyle}" Visibility="{Binding RetryVisibility}"
                                                    Click="RetryTask_Click" ToolTipService.ToolTip="重试任务" AutomationProperties.Name="重试任务">
                                                <FontIcon Glyph="&#xE72C;" FontSize="15" />
                                            </Button>
                                            <Button Style="{StaticResource TransferActionStyle}" Click="CancelTask_Click"
                                                    ToolTipService.ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding ActionLabel}">
                                                <FontIcon Glyph="{Binding ActionIcon}" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100" ShowError="{Binding HasFailed}"
                                                 AutomationProperties.Name="任务进度" />

                                    <StackPanel Grid.Row="2" Spacing="12" Visibility="{Binding DetailsVisibility}">
                                        <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8">
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid MinHeight="30" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="70" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StateMark}" FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CompactDetail}" FontSize="12" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
