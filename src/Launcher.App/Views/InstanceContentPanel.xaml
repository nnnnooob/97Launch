<UserControl
    x:Class="Launcher.App.Views.InstanceContentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ContentRowTemplate">
            <Grid Padding="10,9" ColumnSpacing="12" DoubleTapped="Row_DoubleTapped" RightTapped="Row_RightTapped">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform" Opacity="{Binding IconOpacity}"/>
                    </Border>
                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{Binding DisabledVisibility}"
                            ToolTipService.ToolTip="已禁用" AutomationProperties.Name="已禁用">
                        <Grid Width="14" Height="14">
                            <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                            <Line X1="3.5" Y1="7" X2="10.5" Y2="7" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding NormalVisibility}"/>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorDisabledBrush}" TextDecorations="Strikethrough" Visibility="{Binding DisabledVisibility}"/>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DiagnosticText}" Visibility="{Binding DiagnosticVisibility}" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Click="RowMenu_Click" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ScreenshotTemplate">
            <Grid Width="196" Padding="6" RowSpacing="6" DoubleTapped="Row_DoubleTapped" RightTapped="Row_RightTapped">
                <Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="2"><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                    <Button HorizontalAlignment="Right" Padding="4" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Click="RowMenu_Click" AutomationProperties.Name="更多操作"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="20,18,20,12" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DirectoryLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <CommandBar x:Name="Toolbar" Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False" OverflowButtonVisibility="Auto">
            <AppBarButton Label="打开目录" Icon="OpenFile" Click="OpenFolder_Click"/>
            <AppBarButton x:Name="ImportButton" Label="从文件导入" Icon="Add" Click="Import_Click"/>
            <AppBarButton x:Name="FolderImportButton" Label="导入文件夹" Icon="Folder" Click="ImportFolder_Click"/>
            <AppBarButton x:Name="DownloadButton" Label="下载" Icon="Download" Click="Download_Click"/>
            <AppBarButton x:Name="CheckUpdatesButton" Label="检查更新" Icon="Sync" Click="CheckUpdates_Click"/>
            <AppBarButton x:Name="UpdateAllButton" Label="批量更新" Icon="Upload" Click="UpdateAll_Click"/>
            <AppBarButton x:Name="RestoreModsButton" Label="回退上次变更" Icon="Undo" Click="RestoreMods_Click"/>
            <AppBarButton Label="刷新" Icon="Refresh" Click="Refresh_Click"/>
        </CommandBar>
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索名称或文件名" QueryIcon="Find" TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="112" SelectionChanged="Filter_Changed"/>
        </Grid>
        <Grid Grid.Row="3">
            <ListView x:Name="FileList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="Selection_Changed"
                      HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource ContentRowTemplate}"/>
            <GridView x:Name="ScreenshotList" Visibility="Collapsed" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                      ItemTemplate="{StaticResource ScreenshotTemplate}" SelectionChanged="Selection_Changed"/>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="20">
                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="EmptyTitle" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="6">
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <CommandBar x:Name="SelectionBar" Grid.Row="5" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
            <CommandBar.Content><TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/></CommandBar.Content>
            <AppBarButton Label="全选" Icon="SelectAll" Click="SelectAll_Click"/>
            <AppBarButton x:Name="EnableButton" Label="启用" Icon="Accept" Click="Enable_Click"/>
            <AppBarButton x:Name="DisableButton" Label="禁用" Icon="BlockContact" Click="Disable_Click"/>
            <AppBarButton x:Name="UpdateButton" Label="更新" Icon="Upload" Click="Update_Click"/>
            <AppBarButton Label="删除" Icon="Delete" Click="Delete_Click"/>
            <AppBarButton Label="取消选择" Icon="Cancel" Click="ClearSelection_Click"/>
        </CommandBar>
    </Grid>
</UserControl>
