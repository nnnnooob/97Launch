<UserControl
    x:Class="Launcher.App.Views.InstanceSettingsDialog"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Launcher.App.Controls"
    xmlns:views="using:Launcher.App.Views">

    <!--
      The overlay itself must not take part in the host's measure, so it is given
      the host's bounds by stretching, and the card is positioned against those
      bounds rather than against its own content.
    -->
    <UserControl.Resources>        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Saves, screenshots and packs share one simple row. -->
    </UserControl.Resources>

    <!--
      Modal scrim mounted on the window root. It dims everything behind the card
      and, because it fills the window, swallows clicks intended for the page.
    -->
    <!--
      The scrim fills the page area. The card is inset from it by a fixed padding
      on this grid rather than by a margin on the card: padding shrinks the room the
      card is given, so the gap to the window edge is identical at every window size
      and the card can never overflow.
    -->
    <Grid x:Name="DialogOverlay" Padding="24" Background="#8C000000" SizeChanged="DialogOverlay_SizeChanged">

        <Border
            x:Name="DialogCard"
            Width="1040"
            Height="760"
            MaxWidth="1040"
            MaxHeight="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnSpacing="0">                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ left rail ============ -->
                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="24,22,24,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.InstanceName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,0">
                            <TextBlock
                                Style="{ThemeResource SidebarHeaderStyle}"
                                Text="游戏本体" />

                            <controls:SidebarList
                                x:Name="BodyList"
                                SelectionChanged="BodyList_SelectionChanged"
                                SelectionMode="Single">
                                <ListViewItem Tag="settings" IsSelected="True">
                                    <controls:SidebarItem Title="设置" Icon="{StaticResource IconSliders}" />
                                </ListViewItem>
                                <ListViewItem Tag="modify">
                                    <controls:SidebarItem Title="修改" Icon="{StaticResource IconPencil}" />
                                </ListViewItem>
                                <ListViewItem Tag="export">
                                    <controls:SidebarItem Title="导出" Icon="{StaticResource IconArrowUp}" />
                                </ListViewItem>
                            </controls:SidebarList>

                            <TextBlock
                                Style="{ThemeResource SidebarHeaderStyle}"
                                Text="游戏资源" />

                            <controls:SidebarList
                                x:Name="ResourceList"
                                SelectionChanged="ResourceList_SelectionChanged"
                                SelectionMode="Single">
                                <ListViewItem Tag="saves">
                                    <controls:SidebarItem Title="存档" Icon="{StaticResource IconFolder}" />
                                </ListViewItem>
                                <ListViewItem Tag="screenshots">
                                    <controls:SidebarItem Title="截图" Icon="{StaticResource IconCamera}" />
                                </ListViewItem>
                                <ListViewItem Tag="mods">
                                    <controls:SidebarItem Title="Mod" Icon="{StaticResource IconPuzzle}" />
                                </ListViewItem>
                                <ListViewItem Tag="resourcepacks">
                                    <controls:SidebarItem Title="资源包" Icon="{StaticResource IconBox}" />
                                </ListViewItem>
                                <ListViewItem Tag="shaderpacks">
                                    <controls:SidebarItem Title="光影包" Icon="{StaticResource IconSun}" />
                                </ListViewItem>
                            </controls:SidebarList>
                        </StackPanel>
                    </ScrollViewer>

                    <Button
                        Grid.Row="2"
                        Margin="18,10,18,16"
                        HorizontalAlignment="Stretch"
                        Click="Close_Click"
                        Content="关闭" />
                </Grid>

                <!-- ============ right pane ============ -->
                <Grid Grid.Column="1">

                    <!-- Divider between the rail and the content. -->
                    <Border
                        Width="1"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- 设置 -->
                    <ScrollViewer Padding="20,16,20,16" Visibility="{x:Bind ViewModel.IsSettings, Mode=OneWay}">
                        <StackPanel Spacing="14">

                            <!-- gradient identity card -->
                            <Border
                                Background="{StaticResource StatusHeroBrush}"
                                Style="{ThemeResource StatusHeroCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="56"
                                        Height="56"
                                        VerticalAlignment="Center"
                                        Background="#33FFFFFF"
                                        CornerRadius="10">
                                        <Image
                                            Width="42"
                                            Height="42"
                                            Source="{x:Bind ViewModel.IconPath, Mode=OneWay}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock
                                            Style="{ThemeResource HeroTitleTextStyle}"
                                            Text="{x:Bind ViewModel.InstanceName, Mode=OneWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Style="{ThemeResource HeroChipStyle}">
                                                <TextBlock Style="{ThemeResource HeroChipTextStyle}" Text="{x:Bind ViewModel.GameVersion, Mode=OneWay}" />
                                            </Border>
                                            <Border Style="{ThemeResource HeroChipStyle}">
                                                <TextBlock Style="{ThemeResource HeroChipTextStyle}" Text="{x:Bind ViewModel.LoaderVersion, Mode=OneWay}" />
                                            </Border>
                                            <Border Style="{ThemeResource HeroChipStyle}">
                                                <TextBlock Style="{ThemeResource HeroChipTextStyle}" Text="{x:Bind ViewModel.LaunchCountText, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="RenameInstance_Click"
                                        ToolTipService.ToolTip="修改实例名称">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center" Stretch="Uniform">
                                                <Path Data="{StaticResource IconSettings}" Style="{ThemeResource LineIconStyle}" />
                                            </Viewbox>
                                            <TextBlock FontSize="12" Text="改名" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- launch options -->
                            <Border Style="{ThemeResource PlaceholderCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource SectionHeaderStyle}" Text="启动选项" />
                                    <CheckBox
                                        Content="跟随全局启动选项"
                                        IsChecked="{x:Bind ViewModel.UseGlobalLaunchOptions, Mode=TwoWay}" />

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="版本隔离" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.VersionIsolations}"
                                            SelectedItem="{x:Bind ViewModel.VersionIsolation, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="游戏窗口标题" />
                                        <TextBox
                                            Grid.Column="1"
                                            PlaceholderText="留空则使用默认标题"
                                            Text="{x:Bind ViewModel.WindowTitle, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="进程优先级" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.ProcessPriorities}"
                                            SelectedItem="{x:Bind ViewModel.ProcessPriority, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="窗口大小" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.WindowSizes}"
                                            SelectedItem="{x:Bind ViewModel.WindowSize, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="IP 协议偏好" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.IpPreferences}"
                                            SelectedItem="{x:Bind ViewModel.IpPreference, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Java runtime selection is per-instance, like PCL. -->
                            <Border Style="{ThemeResource PlaceholderCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource SectionHeaderStyle}" Text="Java 运行时" />
                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="选择方式" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.JavaModes}"
                                            SelectedItem="{x:Bind ViewModel.JavaMode, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="指定 Java" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            DisplayMemberPath="Name"
                                            IsEnabled="{x:Bind ViewModel.IsForcedJava, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.AvailableJavaRuntimes, Mode=OneWay}"
                                            SelectedValuePath="Path"
                                            SelectedValue="{x:Bind ViewModel.JavaPath, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.JavaModeHint, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- memory -->
                            <Border Style="{ThemeResource PlaceholderCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource SectionHeaderStyle}" Text="游戏内存" />
                                    <CheckBox
                                        Content="跟随全局内存设置"
                                        IsChecked="{x:Bind ViewModel.UseGlobalMemory, Mode=TwoWay}" />

                                    <RadioButton
                                        x:Name="AutoMemoryRadio"
                                        Checked="MemoryMode_Checked"
                                        Content="{x:Bind ViewModel.AutoMemoryDisplay, Mode=OneWay}"
                                        IsChecked="{x:Bind ViewModel.IsAutoMemory, Mode=TwoWay}" />

                                    <TextBlock Text="{x:Bind ViewModel.MemoryHint, Mode=OneWay}"
                                               Style="{ThemeResource SettingHintStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />

                                    <RadioButton
                                        x:Name="CustomMemoryRadio"
                                        Margin="0,4,0,10"
                                        Checked="MemoryMode_Checked"
                                        Content="自定义" />

                                    <Slider
                                        Maximum="{x:Bind ViewModel.MaximumMemoryGb, Mode=OneWay}"
                                        Minimum="0.5"
                                        StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.CustomMemoryGb, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.IsCustomMemory, Mode=OneWay}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.CustomMemoryDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- advanced -->
                            <Border Style="{ThemeResource PlaceholderCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource SectionHeaderStyle}" Text="高级启动选项" />
                                    <CheckBox
                                        Content="跟随全局高级启动选项"
                                        IsChecked="{x:Bind ViewModel.UseGlobalAdvancedOptions, Mode=TwoWay}" />

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="JVM 参数头部" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.JvmArgsHead, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="游戏参数尾部" />
                                        <TextBox
                                            Grid.Column="1"
                                            PlaceholderText="例如 --demo"
                                            Text="{x:Bind ViewModel.GameArgsTail, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Style="{ThemeResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{ThemeResource SettingLabelStyle}" Text="启动前执行命令" />
                                        <TextBox
                                            Grid.Column="1"
                                            PlaceholderText="留空则不执行"
                                            Text="{x:Bind ViewModel.PreLaunchCommand, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <CheckBox
                                        IsChecked="{x:Bind ViewModel.RequireHighPerformanceGpu, Mode=TwoWay}"
                                        Content="要求 Java 使用高性能显卡" />

                                    <CheckBox
                                        IsChecked="{x:Bind ViewModel.UseJavaExe, Mode=TwoWay}"
                                        Content="使用 java.exe 而不是 javaw.exe" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <views:DownloadInstallDialog x:Name="ModificationView" Visibility="{x:Bind ViewModel.IsModify, Mode=OneWay}" />
                    <views:InstanceExportPanel x:Name="ExportView" Visibility="{x:Bind ViewModel.IsExport, Mode=OneWay}" />
                    <views:InstanceContentPanel x:Name="ContentPanel" Visibility="{x:Bind ViewModel.IsResources, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
