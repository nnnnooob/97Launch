<UserControl
    x:Class="Launcher.App.Views.AccountsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
          Account row: avatar disc, name over type, and the row's own actions. The
          disc uses the HarmonyOS accent at low opacity so the list reads as a set of
          identities rather than a set of buttons.
        -->
        <DataTemplate x:Key="AccountRowTemplate">
            <Grid Padding="0,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  Square head image, matching how Minecraft draws an avatar: the
                  pixel art is upscaled without smoothing, so it reads as a face
                  rather than a blur.
                -->
                <Border
                    Width="36"
                    Height="36"
                    CornerRadius="4">
                    <Image
                        Source="{Binding Avatar}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <!--
                          Marks the account the game will launch with, so switching is
                          not a guess about which row is currently active.
                        -->
                        <Border
                            Padding="5,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Visibility="{Binding CurrentVisibility}">
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="当前" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding TypeDisplay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        Click="SelectAccount_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="切换"
                        ToolTipService.ToolTip="切换到此账号">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path Data="{StaticResource IconSwap}" Style="{ThemeResource LineIconStyle}" />
                        </Viewbox>
                    </Button>
                    <Button
                        Click="DeleteAccount_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="删除"
                        ToolTipService.ToolTip="删除账号">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path Data="{StaticResource IconTrash}" Style="{ThemeResource LineIconStyle}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      Account management renders in a flyout anchored to the account chip rather
      than as a navigation destination. Managing identities is a side task, not a
      place in the app, so it must not steal the whole content frame or leave the
      nav selection pointing at nothing.
    -->
    <StackPanel Width="340" Spacing="0">

        <!-- ============ current accounts ============ -->
        <ListView
            MaxHeight="220"
            SelectionMode="None"
            ItemTemplate="{StaticResource AccountRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasAccounts, Mode=OneWay}" />

        <Border
            Height="1"
            Margin="0,8"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.HasAccounts, Mode=OneWay}" />

        <!-- ============ login type switch ============ -->
        <TextBlock
            Margin="2,0,0,8"
            Style="{ThemeResource SectionHeaderStyle}"
            Text="添加账号" />

        <!--
          Type switch as centred pills, the shape PCL uses for its login type
          chooser: a row of equal-weight options reads as "pick one" where a stack
          of full-width buttons reads as a menu of unrelated commands.
        -->
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <ToggleButton
                x:Name="TabOffline"
                Click="Tab_Click"
                Style="{StaticResource AccountTypePillStyle}"
                Tag="Offline">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconUser}" Style="{ThemeResource LineIconStyle}" />
                    </Viewbox>
                    <TextBlock FontSize="12.5" Text="离线" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                x:Name="TabMicrosoft"
                Click="Tab_Click"
                Style="{StaticResource AccountTypePillStyle}"
                Tag="Microsoft">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconGame}" Style="{ThemeResource LineIconStyle}" />
                    </Viewbox>
                    <TextBlock FontSize="12.5" Text="正版" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                x:Name="TabServer"
                Click="Tab_Click"
                Style="{StaticResource AccountTypePillStyle}"
                Tag="Authlib">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Path Data="{StaticResource IconServer}" Style="{ThemeResource LineIconStyle}" />
                    </Viewbox>
                    <TextBlock FontSize="12.5" Text="第三方" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- ============ offline form ============ -->
        <!--
          PCL's offline panel is a centred skin preview above a single name box, with
          no button: the name is the account, so there is nothing to confirm. The same
          shape is used here, with the preview showing the head the name will produce.
        -->
        <StackPanel
            x:Name="PaneOffline"
            Margin="0,14,0,0"
            Spacing="10">
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                CornerRadius="4">
                <Image Source="{x:Bind ViewModel.OfflineHeadPreview, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <TextBox
                x:Name="OfflineNameBox"
                PlaceholderText="游戏用户名"
                TextChanged="OfflineName_Changed" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.OfflinePreview, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    Grid.Column="1"
                    Click="AddOffline_Click"
                    Content="添加"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>

        <!-- ============ microsoft form ============ -->
        <!--
          One button. The code and link belong to a dialog, as in PCL: the panel is
          narrow, the code has to stay visible while the browser is open, and the
          dialog owns the polling so closing it cancels the login.
        -->
        <StackPanel
            x:Name="PaneMicrosoft"
            Margin="0,14,0,0"
            Spacing="10"
            Visibility="Collapsed">
            <TextBlock
                FontSize="11.5"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="登录会在浏览器中完成，不会接触你的微软密码。"
                TextWrapping="Wrap" />

            <!--
              The button becomes the progress display, as in PCL: it greys out and its
              caption counts up. A separate spinner elsewhere would leave the button
              looking ready to be pressed again while the chain is running.
            -->
            <Button
                x:Name="MsLoginButton"
                HorizontalAlignment="Stretch"
                Click="AddMicrosoft_Click"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <TextBlock Text="{x:Bind ViewModel.MicrosoftButtonText, Mode=OneWay}" />
            </Button>

            <!-- This pane's own failure text; see the note on the third-party pane. -->
            <TextBlock
                FontSize="11.5"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.MicrosoftError, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasMicrosoftError, Mode=OneWay}" />
        </StackPanel>

        <!-- ============ third-party form ============ -->
        <!--
          PCL's authlib and Nide panels are the same shape: a server address box, an
          account box, a password box, a remember-password checkbox, and a register
          link on the right. Reproduced field for field, with the server box added
          above because this launcher stores the address per account.
        -->
        <StackPanel
            x:Name="PaneServer"
            Margin="0,14,0,0"
            Spacing="10"
            Visibility="Collapsed">
            <TextBox
                x:Name="ServerBox"
                PlaceholderText="认证服务器地址，或统一通行证服务器 ID" />

            <TextBox
                x:Name="ServerNameBox"
                PlaceholderText="邮箱" />

            <PasswordBox
                x:Name="ServerPassBox"
                PasswordChanged="ServerPassword_Changed"
                PasswordRevealMode="Peek"
                PlaceholderText="密码" />

            <Grid>
                <CheckBox
                    x:Name="RememberBox"
                    Content="记住密码"
                    IsChecked="True" />

                <HyperlinkButton
                    HorizontalAlignment="Right"
                    Click="Register_Click"
                    Content="注册账号"
                    FontSize="12.5"
                    Padding="8,0,0,0" />
            </Grid>

            <Button
                x:Name="ServerLoginButton"
                HorizontalAlignment="Stretch"
                Click="LoginServer_Click"
                Content="登录"
                Style="{StaticResource AccentButtonStyle}" />

            <!--
              This pane's own progress and error. Each form reports its own failure,
              because an authlib error code only means something next to the server
              and account that produced it.
            -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasServerError, Mode=OneWay}">
                <TextBlock
                    FontSize="11.5"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ServerError, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
