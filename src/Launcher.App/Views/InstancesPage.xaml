<Page
    x:Class="Launcher.App.Views.InstancesPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Launcher.App.Views"
    xmlns:controls="using:Launcher.App.Controls">

        <Page.Resources>
<ResourceDictionary>
<ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#EAF2FC" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#F1F5FA" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#DFEAF8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#26384F" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#29313C" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#344359" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
<Style x:Key="InstanceRowHitTargetStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" /><Setter Property="FocusVisualMargin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RowRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowHoverBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowPressedBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RowRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
<SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
<SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
<SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />

            <!-- One compact row shared by all instance sections. -->
            <DataTemplate x:Key="InstanceCardTemplate">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--
                      Full-card hit target. A transparent Button fills the card so
                      the whole row is clickable and shows the standard press
                      feedback; the content sits above it but with IsHitTestVisible
                      off, so clicks reach this button rather than being swallowed
                      by whichever TextBlock happens to be under the cursor.
                    -->
                    <Button
                        Grid.ColumnSpan="2"
                        Style="{StaticResource InstanceRowHitTargetStyle}"
                        Click="InstanceCard_Click"
                        ToolTipService.ToolTip="{Binding Name}" />

                    <Grid
                        Grid.Column="0"
                        ColumnSpacing="12"
                        IsHitTestVisible="False"
                        Padding="14,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Block icon for the loader type, in the style PCL2 uses:
                             a vanilla block tile standing in for each loader. -->
                        <Border
                            Width="38"
                            Height="38"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Image
                                    x:Name="BlockIcon"
                                    Width="30"
                                    Height="30"
                                    Source="{Binding IconPath}"
                                    Stretch="Uniform"
                                    ImageFailed="BlockIcon_Failed" />
                                <Viewbox
                                    x:Name="BlockIconFallback"
                                    Width="20"
                                    Height="20"
                                    Stretch="Uniform"
                                    Visibility="Collapsed">
                                    <Path Data="{StaticResource IconBox}" Style="{ThemeResource LineIconStyle}" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{ThemeResource InstanceNameTextStyle}" FontSize="15"
                                       Text="{Binding Name}" />

                            <TextBlock Style="{ThemeResource InstanceMetaTextStyle}">
                                <Run Text="{Binding GameVersion}" /><Run Text=" · " /><Run Text="{Binding LoaderVersion}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!--
                      Row actions. Kept icon-only and 28px so three of them do not
                      out-weigh the instance name; each carries a tooltip instead
                      of a visible label. They sit in their own layer above the
                      hit target so they still receive their own clicks.
                    -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Style="{ThemeResource CardActionButtonStyle}"
                            Click="InstanceSettings_Click"
                            Tag="{Binding Name}"
                            ToolTipService.ToolTip="设置">
                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                <Path Data="{StaticResource IconSettings}" Style="{ThemeResource LineIconStyle}" />
                            </Viewbox>
                        </Button>

                        <Button
                            Style="{ThemeResource CardActionButtonStyle}"
                            Click="InstanceOpenFolder_Click"
                            Tag="{Binding Name}"
                            ToolTipService.ToolTip="打开目录">
                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                <Path Data="{StaticResource IconFolder}" Style="{ThemeResource LineIconStyle}" />
                            </Viewbox>
                        </Button>

                        <Button
                            Style="{ThemeResource CardActionButtonStyle}"
                            Click="InstanceDelete_Click"
                            Tag="{Binding Name}"
                            ToolTipService.ToolTip="删除">
                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                <Path Data="{StaticResource IconTrash}" Style="{ThemeResource LineIconStyle}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
</Page.Resources>

    <!--
      Two panes: a folder rail on the left and the instances of the selected
      folder on the right. The page itself does not scroll; each pane scrolls
      independently so the folder list stays anchored while browsing instances.
    -->
    <!--
      Outer grid exists so the instance settings dialog can float above the whole
      page. The page content is blurred while the dialog is open; the dialog is a
      sibling drawn on top rather than a child, so it stays sharp.
    -->
    <Grid>
    <Grid x:Name="PageContent" Padding="24,20,24,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ left: game folders ============ -->
        <Border Grid.Column="0" Style="{ThemeResource FolderRailStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Style="{ThemeResource SidebarHeaderStyle}"
                    Text="游戏文件夹" />

                <controls:SidebarList
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Folders}"
                    SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                    AutomationProperties.Name="游戏文件夹">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:SidebarItem Title="{Binding Name}" Subtitle="{Binding PathDisplay}"
                                                  Badge="{Binding CountDisplay}" Icon="{StaticResource IconFolder}"
                                                  RightTapped="FolderRow_RightTapped" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </controls:SidebarList>

                <!-- Folder actions pinned to the bottom of the rail. -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="6">
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="AddFolder_Click"
                        ToolTipService.ToolTip="把已有的 .minecraft 文件夹加入列表">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFolderPlus}" Style="{ThemeResource LineIconStyle}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="添加已有文件夹" />
                        </StackPanel>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="ImportModpack_Click"
                        ToolTipService.ToolTip="从整合包压缩文件导入一个新实例">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPuzzle}" Style="{ThemeResource LineIconStyle}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="导入整合包" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ right: instances in the selected folder ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- search -->
            <Grid x:Name="SearchToolbar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="搜索实例"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <Button
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="重新扫描该文件夹">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Path Data="{StaticResource IconRefresh}" Style="{ThemeResource LineIconStyle}" />
                        </Viewbox>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- Scanning/empty-state text is overlaid on the sections. Empty
                 groups are hidden like PCL; only non-empty group headers count. -->
            <Border
                x:Name="EmptyState"
                Grid.Row="1"
                Canvas.ZIndex="1"
                Margin="0,12,0,0"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel x:Name="EmptyContent" MaxWidth="620" Spacing="12">
                    <TextBlock
                        x:Name="EmptyTitle"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="无可用实例" />
                    <Rectangle
                        x:Name="EmptyDivider"
                        Height="2"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock
                        x:Name="EmptyMessage"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="未找到任何游戏实例，请先下载一个游戏实例。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="EmptyDownloadButton"
                        HorizontalAlignment="Center"
                        MinWidth="140"
                        Content="下载游戏"
                        Click="EmptyDownload_Click" />
                </StackPanel>
            </Border>

            <!-- scrolling instance sections -->
            <ScrollViewer
                x:Name="InstanceScroller"
                Grid.Row="1"
                Margin="0,12,0,0"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel x:Name="InstanceSections" Spacing="8" Margin="0,0,12,0">

                    <!-- ======== moddable ======== -->
                    <Expander x:Name="ModdableSection" Style="{StaticResource InstanceGroupStyle}"
                      IsExpanded="{x:Bind ViewModel.IsModdableExpanded, Mode=TwoWay}">
    <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="可安装模组实例" />
            <TextBlock x:Name="ModdableCount" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Expander.Header>
    <ListView x:Name="ModdableList" ItemTemplate="{StaticResource InstanceCardTemplate}"
              Style="{StaticResource InstanceGroupListStyle}" ItemContainerStyle="{StaticResource InstanceGroupRowStyle}"
              ItemsSource="{x:Bind ViewModel.ModdableInstances}" />
</Expander>

                    <!-- regular -->
                    <Expander x:Name="RegularSection" Style="{StaticResource InstanceGroupStyle}"
                      IsExpanded="{x:Bind ViewModel.IsRegularExpanded, Mode=TwoWay}">
    <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="常规实例" />
            <TextBlock x:Name="RegularCount" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Expander.Header>
    <ListView x:Name="RegularList" ItemTemplate="{StaticResource InstanceCardTemplate}"
              Style="{StaticResource InstanceGroupListStyle}" ItemContainerStyle="{StaticResource InstanceGroupRowStyle}"
              ItemsSource="{x:Bind ViewModel.RegularInstances}" />
</Expander>

                    <!-- rarely used (collapsed by default) -->
                    <Expander x:Name="RareSection" Style="{StaticResource InstanceGroupStyle}"
                      IsExpanded="{x:Bind ViewModel.IsRareExpanded, Mode=TwoWay}">
    <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="不常用实例" />
            <TextBlock x:Name="RareCount" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Expander.Header>
    <ListView x:Name="RareList" ItemTemplate="{StaticResource InstanceCardTemplate}"
              Style="{StaticResource InstanceGroupListStyle}" ItemContainerStyle="{StaticResource InstanceGroupRowStyle}"
              ItemsSource="{x:Bind ViewModel.RareInstances}" />
</Expander>

                    <Expander x:Name="ErrorSection" Style="{StaticResource InstanceGroupStyle}"
                              IsExpanded="{x:Bind ViewModel.IsErrorExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="错误实例" />
                                <TextBlock x:Name="ErrorCount" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <ListView ItemTemplate="{StaticResource InstanceCardTemplate}" Style="{StaticResource InstanceGroupListStyle}"
                                  ItemContainerStyle="{StaticResource InstanceGroupRowStyle}" ItemsSource="{x:Bind ViewModel.ErrorInstances}" />
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!--
              Scroll-to-top button. Floats over the bottom-right of the list and
              only appears once the user has scrolled away from the top, so it
              never sits on top of content the user has not left behind.
            -->
            <Button
                x:Name="ScrollTopButton"
                Grid.Row="1"
                Margin="0,0,12,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="ScrollTop_Click"
                Style="{ThemeResource ScrollTopButtonStyle}"
                ToolTipService.ToolTip="回到顶部"
                Visibility="Collapsed">
                <Viewbox Width="16" Height="16" Stretch="Uniform">
                    <Path Data="{StaticResource IconArrowUp}" Style="{ThemeResource LineIconStyle}" />
                </Viewbox>
            </Button>
        </Grid>

    </Grid>

        <!--
          Dialog host, a sibling of the page content. Mounting the dialog here
          rather than on the window ties its lifetime to this page: navigating away
          takes the dialog with it, instead of leaving a modal floating over a page
          it does not belong to.
        -->
        <Grid
            x:Name="DialogHost"
            Canvas.ZIndex="100"
            Visibility="Collapsed" />
    </Grid>
</Page>
