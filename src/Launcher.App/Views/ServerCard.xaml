<UserControl x:Class="Launcher.App.Views.ServerCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Launcher.App.Controls" SizeChanged="Card_SizeChanged">
 <Border x:Name="CardSurface" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="ImageRegion" Height="238" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="11,11,0,0">
    <Image Source="{Binding IconPath}" Stretch="Uniform" AutomationProperties.Name="服务器图标" />
   </Border>
   <Grid Grid.Row="1" Padding="12" RowSpacing="7">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
    <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding LatencyHint}" AutomationProperties.Name="{Binding LatencyHint}">
       <StackPanel Orientation="Horizontal" Spacing="1" Height="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
        <Rectangle Width="3" Height="3" RadiusX="0.5" RadiusY="0.5" VerticalAlignment="Bottom" Fill="{Binding SignalBrush}" Opacity="{Binding Signal1Opacity}"/>
        <Rectangle Width="3" Height="6" RadiusX="0.5" RadiusY="0.5" VerticalAlignment="Bottom" Fill="{Binding SignalBrush}" Opacity="{Binding Signal2Opacity}"/>
        <Rectangle Width="3" Height="9" RadiusX="0.5" RadiusY="0.5" VerticalAlignment="Bottom" Fill="{Binding SignalBrush}" Opacity="{Binding Signal3Opacity}"/>
        <Rectangle Width="3" Height="12" RadiusX="0.5" RadiusY="0.5" VerticalAlignment="Bottom" Fill="{Binding SignalBrush}" Opacity="{Binding Signal4Opacity}"/>
       </StackPanel>
       <TextBlock Text="{Binding LatencyText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding PlayersText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <StackPanel Grid.Row="3" Spacing="6">
     <TextBlock Text="{Binding VersionText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding VersionText}" />
     <Button Click="CopyAddress_Click" HorizontalAlignment="Left" MaxWidth="160" Height="26" MinHeight="0" MinWidth="0" Padding="8,2" CornerRadius="13"
       Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
       UseSystemFocusVisuals="True" FocusVisualMargin="2"
       ToolTipService.ToolTip="{Binding Address}" AutomationProperties.Name="{Binding CopyAddressLabel}">
      <Button.Resources>
       <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
       <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
       <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush"/>
       <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush"/>
      </Button.Resources>
      <TextBlock Text="{Binding Address}" FontSize="11" TextTrimming="CharacterEllipsis"/>
     </Button>
    </StackPanel>
    <StackPanel Grid.Row="4" Spacing="6">
     <Button Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}" Click="Install_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" CornerRadius="8" FontSize="13"/>
     <controls:LaunchActionButton Content="{Binding JoinText}" IsEnabled="{Binding CanJoin}" IsLaunching="{Binding IsJoining}" CompactIcon="True"
       Click="Join_Click" Style="{ThemeResource LaunchButtonStyle}" Height="38" CornerRadius="8" FontSize="13" Padding="0"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</UserControl>
