<UserControl
    x:Class="Launcher.App.Views.ResourceDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" KeyDown="Dialog_KeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#EAF2FC" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#F1F5FA" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#DFEAF8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="#26384F" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="#29313C" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="#344359" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ResourceRowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ResourceRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ResourceRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" /><Setter Property="FocusVisualMargin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RowRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowHoverBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowRoot.Background" Value="{ThemeResource ResourceRowPressedBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RowRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ResourceFilterChipStyle" TargetType="GridViewItem">
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2,1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid x:Name="ChipRoot" Background="Transparent" CornerRadius="14">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ChipRoot.Background" Value="{ThemeResource ResourceRowHoverBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ChipRoot.Background" Value="{ThemeResource ResourceRowPressedBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="ChipRoot.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="ChipContent.Foreground" Value="White" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="ChipRoot.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" /><Setter Target="ChipContent.Foreground" Value="White" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="ChipRoot.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="ChipContent.Foreground" Value="White" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ChipRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ChipContent" Content="{TemplateBinding Content}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="13" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Overlay" Background="#8C000000" Padding="16" SizeChanged="Overlay_SizeChanged">
        <Border x:Name="DialogCard" Width="900" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel Spacing="8">
                        <Border Background="{StaticResource StatusHeroBrush}" CornerRadius="9" Padding="12,10">
                            <Grid ColumnSpacing="10" RowSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button x:Name="BackButton" Visibility="Collapsed" Width="28" Height="28" Padding="0" Click="Back_Click"
                                        Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" ToolTipService.ToolTip="返回上一个资源">
                                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                                </Button>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="7" Background="#22FFFFFF">
                                    <Image x:Name="ProjectIcon" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProjectName" Foreground="White" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProjectDescription" Foreground="#EFFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="CloseButton" Grid.Column="3" Width="28" Height="28" Padding="0" Background="Transparent" Foreground="White"
                                        BorderThickness="0" VerticalAlignment="Top" Click="Close_Click" ToolTipService.ToolTip="关闭资源详情">
                                    <FontIcon FontSize="13" Glyph="&#xE8BB;" />
                                </Button>
                                <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProjectSource" Foreground="#EFFFFFFF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Click="ProjectWebsite_Click" FontSize="12" Padding="7,3" CornerRadius="12"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE774;" FontSize="12" /><TextBlock Text="项目主页" /></StackPanel></Button>
                                        <Button Click="CopyName_Click" FontSize="12" Padding="7,3" CornerRadius="12"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock Text="复制名称" /></StackPanel></Button>
                                        <Button Click="CopyLink_Click" FontSize="12" Padding="7,3" CornerRadius="12"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE71B;" FontSize="12" /><TextBlock Text="复制链接" /></StackPanel></Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
                        <Button x:Name="RetryButton" Content="重新获取版本" Click="Retry_Click" Visibility="Collapsed" />
                        <Grid x:Name="PackNamePanel" Visibility="Collapsed" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="实例名称" />
                            <TextBox x:Name="PackNameBox" Grid.Column="1" PlaceholderText="为新实例命名" />
                        </Grid>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6">
                            <Grid RowSpacing="4" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="游戏版本" FontSize="12" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <GridView x:Name="GameVersionFilters" Grid.Column="1" Grid.ColumnSpan="2" SelectionMode="Single" SelectionChanged="Filter_Changed"
                                          ItemContainerStyle="{StaticResource ResourceFilterChipStyle}" Padding="0"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="62" ItemHeight="30" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                </GridView>
                                <TextBlock x:Name="LoaderFilterLabel" Grid.Row="1" Text="加载器" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <GridView x:Name="LoaderFilters" Grid.Row="1" Grid.Column="1" SelectionMode="Single" SelectionChanged="Filter_Changed"
                                          ItemContainerStyle="{StaticResource ResourceFilterChipStyle}" Padding="0"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="80" ItemHeight="30" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                </GridView>
                                <CheckBox x:Name="StableOnlyBox" Grid.Row="1" Grid.Column="2" Content="仅正式版" IsChecked="False" MinHeight="28" FontSize="12"
                                          Checked="StableOnly_Changed" Unchecked="StableOnly_Changed" />
                            </Grid>
                        </Border>
                        <ProgressRing x:Name="LoadingRing" Width="26" Height="26" IsActive="False" Visibility="Collapsed" />
                        <StackPanel x:Name="VersionGroups" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SelectedVersionText" Text="请选择发布版本" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TargetText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CompatibilityHint" FontSize="11" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="SaveButton" Grid.Column="1" Height="36" Content="另存为" IsEnabled="False" Click="Save_Click" />
                        <Button x:Name="InstallButton" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Height="36" MinWidth="72"
                                Padding="16,0" FontSize="13" IsEnabled="False" Click="Install_Click" Content="安装" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
