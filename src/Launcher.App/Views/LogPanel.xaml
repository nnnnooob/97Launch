<UserControl
    x:Class="Launcher.App.Views.LogPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Right-hand activity log. Fixed to the shell rather than living inside a
      page: a download continues while the user browses settings, so the output
      must not disappear when they navigate away.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Border Grid.Row="0" Style="{ThemeResource LogHeaderStyle}">
            <Grid Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLog}" Style="{ThemeResource LineIconStyle}" />
                </Viewbox>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="运行日志" />

                <Button
                    Grid.Column="2"
                    Padding="7,3"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Clear_Click"
                    ToolTipService.ToolTip="清空日志">
                    <Viewbox Width="13" Height="13" Stretch="Uniform">
                        <Path Data="{StaticResource IconTrash}" Style="{ThemeResource LineIconStyle}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- ============ empty state ============ -->
        <StackPanel
            Grid.Row="1"
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <Viewbox Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center">
                <Path
                    Data="{StaticResource IconLog}"
                    Style="{ThemeResource LineIconStyle}"
                    Stroke="{ThemeResource TextFillColorDisabledBrush}" />
            </Viewbox>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                Text="暂无日志" />
        </StackPanel>

        <!-- ============ log lines ============ -->
        <ListView
            x:Name="LogList"
            Grid.Row="1"
            ItemsSource="{x:Bind Log.Entries}"
            ItemContainerStyle="{ThemeResource LogListViewItemStyle}"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="16,4,12,12">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--
                      Timestamp and level stay in fixed columns, and the message
                      wraps in the remainder: a log is scanned by time and
                      severity, so those must line up down the pane.
                    -->
                    <Grid Style="{ThemeResource LogRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{ThemeResource LogMetaTextStyle}"
                            Text="{Binding TimeDisplay}" />

                        <Border Grid.Column="1" Style="{ThemeResource LogLevelBadgeStyle}">
                            <TextBlock
                                x:Name="LevelText"
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="{Binding KindDisplay}" />
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            Style="{ThemeResource LogMessageTextStyle}"
                            Text="{Binding Message}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
