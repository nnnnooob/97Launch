<UserControl
    x:Class="Launcher.App.Views.ApplicationUpdatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="24">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="48" Height="48">
                        <FontIcon Glyph="&#xE895;" FontSize="22" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="97Launch" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentVersion" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="应用更新进度"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CheckButton" Content="检查更新" Click="Check_Click"/>
                    <Button x:Name="ActionButton" Style="{ThemeResource AccentButtonStyle}" Content="下载更新" Click="Action_Click" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="取消下载" Click="Cancel_Click" Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"/>
            </StackPanel>
        </Border>
        <Border x:Name="ReleaseCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="24" Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBlock x:Name="ReleaseTitle" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReleaseNotes" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="24">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="更新通道"/><TextBlock Text="测试版包含提前体验的更新" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                    <ComboBox x:Name="ChannelBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Channel_Changed">
                        <ComboBoxItem Content="稳定版"/><ComboBoxItem Content="测试版"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="StartupCheck" Content="启动时检查更新" Click="Startup_Click"/>
                <TextBlock Text="下载完成后由你选择重启时间，更新会保留游戏实例和个人设置。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
